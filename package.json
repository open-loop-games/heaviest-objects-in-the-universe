{
  "name": "heaviest-objects-in-the-universe",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-devicons.js",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "oxlint src --fix",
    "circular": "dpdm --circular --exit-code circular:1 --exclude node_modules 'src/game/*.ts'",
    "lint:check": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "build:itch": "node scripts/copy-devicons.js && vue-tsc -b && BASE_URL=./ vite build && rm -f itch_assets/heaviest-objects-in-the-universe.zip && cd dist && zip -r ../itch_assets/heaviest-objects-in-the-universe.zip .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,css,html,json}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,vue}": "oxlint --fix"
  },
  "dependencies": {
    "@open-loop/engine": "^0.5.1",
    "break_eternity.js": "^2.1.3",
    "eternal_notations": "^1.1.1",
    "pixi.js": "^8.17.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.8.1",
    "devicon": "^2.17.0",
    "dpdm": "^3.14.0",
    "husky": "^9.1.7",
    "knip": "^5.78.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0"
}
