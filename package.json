{
  "name": "heaviest-objects-in-the-universe",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-devicons.js",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint src --fix",
    "circular": "dpdm --circular --exit-code circular:1 --exclude open-loop-engine 'src/game/*.ts'",
    "lint:check": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "build:itch": "node scripts/copy-devicons.js && vue-tsc -b && BASE_URL=./ vite build && rm -f itch_assets/heaviest-objects-in-the-universe.zip && cd dist && zip -r ../itch_assets/heaviest-objects-in-the-universe.zip .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@open-loop/engine": "^0.1.0",
    "break_eternity.js": "^2.1.3",
    "eternal_notations": "^1.1.1",
    "pixi.js": "^8.17.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.8.1",
    "devicon": "^2.17.0",
    "dpdm": "^3.14.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "knip": "^5.78.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0"
}
